# API Backend URL.
# - Development: trỏ tới backend local (đã có proxy rewrites trong next.config.mjs)
# - Production: trỏ tới backend domain trên Vercel
#
# Development (uncomment dòng bạn cần):
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# NEXT_PUBLIC_API_URL=https://cabmarket-api.vercel.app/api